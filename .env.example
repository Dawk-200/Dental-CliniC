# ---------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file to version control.
# ---------------------------------------------------------

# Flask
FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
SESSION_COOKIE_SECURE=True

# Database
# Leave blank to use the default SQLite file at instance/clinic.db
DATABASE_URL=

# Admin bootstrap (only used the first time seed.py is run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Site
SITE_URL=https://www.yourclinic.com

# WhatsApp (just the phone number, international format, no plus sign)
WHATSAPP_NUMBER=10000000000

# Google Maps embed URL (Contact page)
GOOGLE_MAPS_EMBED_URL=

# Google Analytics / Search Console (optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=

# Email (optional - for future reminder integration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# WhatsApp Business API (optional - for future automated reminder integration)
WHATSAPP_API_TOKEN=
WHATSAPP_API_URL=
